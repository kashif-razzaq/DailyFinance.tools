<?xml version="1.0" encoding="UTF-8"?>
<!--
  DailyFinance.tools — sitemap stylesheet.
  Renders the XML sitemaps as a designed, clickable page for humans
  (the Yoast-style presentation). Crawlers read the raw XML as usual;
  Google Search Console accepts styled sitemaps exactly the same way.
-->
<xsl:stylesheet version="1.0"
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:sm="http://www.sitemaps.org/schemas/sitemap/0.9"
  exclude-result-prefixes="sm">

  <xsl:output method="html" encoding="UTF-8" indent="yes"/>

  <xsl:template match="/">
    <html lang="en">
      <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>XML Sitemap — DailyFinance.tools</title>
        <style>
          * { box-sizing: border-box; }
          body { margin: 0; font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background: #fafafa; color: #18181b; }
          header { background: #064E3B; color: #fff; padding: 28px 20px; }
          .wrap { max-width: 980px; margin: 0 auto; }
          header .brand { font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: #D97706; font-weight: 700; }
          header h1 { margin: 6px 0 8px; font-size: 28px; font-weight: 800; letter-spacing: -0.02em; }
          header p { margin: 0; color: rgba(255,255,255,.82); font-size: 14px; line-height: 1.55; max-width: 640px; }
          header a { color: #fff; font-weight: 600; }
          main { padding: 26px 20px 40px; }
          .count { font-size: 14px; color: #52525b; margin: 0 0 14px; }
          .count strong { color: #064E3B; }
          table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid #e4e4e7; border-radius: 14px; overflow: hidden; }
          th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: .1em; color: #71717a; background: #f4f4f5; padding: 10px 14px; border-bottom: 1px solid #e4e4e7; }
          td { padding: 9px 14px; font-size: 13.5px; border-bottom: 1px solid #f1f1f4; vertical-align: top; }
          tr:last-child td { border-bottom: none; }
          tr:nth-child(even) td { background: #fcfcfd; }
          td.n { color: #a1a1aa; width: 44px; }
          td.meta { color: #71717a; white-space: nowrap; }
          a.url { color: #064E3B; text-decoration: none; font-weight: 550; word-break: break-all; }
          a.url:hover { text-decoration: underline; }
          footer { padding: 0 20px 34px; color: #a1a1aa; font-size: 12.5px; }
          footer a { color: #064E3B; }
        </style>
      </head>
      <body>
        <header>
          <div class="wrap">
            <div class="brand">DailyFinance.tools</div>
            <h1>XML Sitemap</h1>
            <p>This sitemap is generated for search engines. You are seeing the
            human-readable view — every link below is clickable and listed in
            hierarchy order. Back to <a href="https://dailyfinance.tools/">DailyFinance.tools</a>.</p>
          </div>
        </header>
        <main>
          <div class="wrap">
            <xsl:apply-templates select="sm:sitemapindex"/>
            <xsl:apply-templates select="sm:urlset"/>
          </div>
        </main>
        <footer>
          <div class="wrap">Generated by <a href="https://dailyfinance.tools/">DailyFinance.tools</a> · <a href="https://dailyfinance.tools/sitemap.xml">Sitemap index</a></div>
        </footer>
      </body>
    </html>
  </xsl:template>

  <!-- Index of child sitemaps -->
  <xsl:template match="sm:sitemapindex">
    <p class="count">This index contains <strong><xsl:value-of select="count(sm:sitemap)"/></strong> sitemaps.</p>
    <table>
      <tr><th>#</th><th>Sitemap</th><th>Last modified</th></tr>
      <xsl:for-each select="sm:sitemap">
        <tr>
          <td class="n"><xsl:value-of select="position()"/></td>
          <td><a class="url" href="{sm:loc}"><xsl:value-of select="sm:loc"/></a></td>
          <td class="meta"><xsl:value-of select="sm:lastmod"/></td>
        </tr>
      </xsl:for-each>
    </table>
  </xsl:template>

  <!-- One sitemap file of URLs -->
  <xsl:template match="sm:urlset">
    <p class="count">This sitemap contains <strong><xsl:value-of select="count(sm:url)"/></strong> URLs.</p>
    <table>
      <tr><th>#</th><th>URL</th><th>Last modified</th><th>Change frequency</th><th>Priority</th></tr>
      <xsl:for-each select="sm:url">
        <tr>
          <td class="n"><xsl:value-of select="position()"/></td>
          <td><a class="url" href="{sm:loc}"><xsl:value-of select="sm:loc"/></a></td>
          <td class="meta"><xsl:value-of select="substring(sm:lastmod, 1, 10)"/></td>
          <td class="meta"><xsl:value-of select="sm:changefreq"/></td>
          <td class="meta"><xsl:value-of select="sm:priority"/></td>
        </tr>
      </xsl:for-each>
    </table>
  </xsl:template>

</xsl:stylesheet>
